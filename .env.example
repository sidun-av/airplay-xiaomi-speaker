# Home Assistant base URL, reachable from the Docker host.
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA: Profile -> Security -> Long-Lived Access Tokens).
HA_TOKEN=
# The speaker's media_player entity created by Xiaomi Miot Auto.
SPEAKER_ENTITY=media_player.xiaomi_oh2p_xxxx_play_control
# LAN IP of the Docker host as seen by the speaker (not localhost).
HOST_IP=192.0.2.10
